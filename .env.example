NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://wager:wager@postgres:5432/wager
REDIS_URL=redis://redis:6379
SQS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_EVENT_QUEUE_URL=http://localstack:4566/000000000000/wager-events.fifo
SQS_WAGER_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
OIDC_ISSUER_URL=http://localhost:8080/realms/wager
OIDC_JWKS_URL=http://localhost:8080/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-api
PROVIDER_SECRET_ENCRYPTION_KEY=replace-with-a-32-character-development-secret
HMAC_MAX_SKEW_SECONDS=300
PENDING_REFERENCE_TTL_MINUTES=1440
PENDING_REFERENCE_MAX_ATTEMPTS=20
